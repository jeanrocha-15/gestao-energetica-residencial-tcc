{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gestao-energetica-local",
  "main": "local/worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "durable_objects": { "bindings": [{ "name": "TUYA_COLLECTOR", "class_name": "TuyaCollector" }] },
  "migrations": [{ "tag": "tuya-collector-v1", "new_sqlite_classes": ["TuyaCollector"] }],
  "dev": { "ip": "127.0.0.1", "port": 5173 },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "gestao-energetica-local",
    "database_id": "11111111-1111-4111-8111-111111111111",
    "migrations_dir": "drizzle",
    "remote": false
  }],
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true }
}
